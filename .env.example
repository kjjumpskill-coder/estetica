# Скопіюй у .env і заповни. Файл .env не потрапляє ні в git, ні на деплой.

# local | production
APP_ENV=local
# на проді обов'язково false
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=db
DB_PORT=3306
DB_NAME=estetika
DB_USER=estetika
DB_PASS=secret
DB_CHARSET=utf8mb4

# Статичний кеш головної сторінки, секунд. 0 = вимкнено (зручно при верстці).
CACHE_TTL=3600

# Telegram. Бот створений — токен взяти в BotFather.
TG_BOT_TOKEN=
# Довільний рядок, звіряється з заголовком X-Telegram-Bot-Api-Secret-Token
TG_SECRET_TOKEN=
TG_OWNER_CHAT_ID=

# Аналітика: сіль для visitor_hash. Довгий довільний рядок, cron змінює щодоби.
ANALYTICS_SALT=

# Деплой на ukraine.com.ua
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=
DEPLOY_PORT=22
